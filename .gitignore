# Publication is opt-in. Local histories and machine-specific notes stay private.
*
!.gitignore
!README.md
!LICENSE
!pyproject.toml
!tokenometer.example.json
!tokenometer/
!tokenometer/collectors/
!tokenometer/**/*.py
!tests/
!tests/**/*.py
!scripts/
!scripts/collect.sh
!scripts/refresh.sh
!scripts/preview.sh
!scripts/daily-refresh.sh
!scripts/install-daily-refresh.py
!docs/
!docs/PUBLISHING.md
!docs/DAILY-REFRESH.md
!.github/
!.github/workflows/
!.github/workflows/check.yml
!web/
!web/index.html
!web/app.js
!web/styles.css
!web/favicon.svg
!web/data.json
!web/_headers
!web/404.html
# Always private, including inside explicitly allowed directories.
.local/
.git/
__pycache__/
*.py[cod]
.env*
*.sqlite*
*.db*
*.jsonl*
*.pem
*.key
.DS_Store
